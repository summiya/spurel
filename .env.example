# Spurel local development environment
#
# Run 'make init' to create .env and generate a strong API bearer token.
# For manual host commands, source .env in your shell first.
# Never commit real secrets.

# PostgreSQL (example credentials are for loopback-only development)
# Compose uses the 'postgres' hostname internally and overrides DATABASE_URL.
# Shell-based commands still use the localhost URL below.
SPUREL_POSTGRES_PASSWORD=spurel
SPUREL_POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://spurel:spurel@localhost:5432/spurel

# Local development ports (published only on 127.0.0.1)
SPUREL_API_PORT=8000
SPUREL_FRONTEND_PORT=3000

# Local document blob storage (development/testing only)
SPUREL_LOCAL_STORAGE_ROOT=.spurel/storage

# OpenAI
# Keep real API keys only in your local .env or secret manager.
OPENAI_API_KEY=

# Embeddings (default unchanged: OpenAI)
SPUREL_EMBEDDING_PROVIDER=openai
SPUREL_EMBEDDING_MODEL=text-embedding-3-small
SPUREL_EMBEDDING_DIMENSIONS=1536

# SP-25: trusted hosted OpenAI-compatible embeddings (only if provider=openai_compatible)
# SPUREL_EMBEDDING_BASE_URL=https://your-embedding-service.example/v1
# SPUREL_EMBEDDING_API_KEY=your-secret-embedding-key

# SP-25: native Ollama for local embeddings or generation (only if provider=ollama).
# Run your own Ollama service and pull models explicitly before using the API.
# Compose's backend can resolve host.docker.internal via a host-gateway mapping.
# Ollama is NOT started by Spurel, and no model is downloaded automatically.
# SPUREL_OLLAMA_BASE_URL=http://host.docker.internal:11434

# Advanced PDF processing (SP-18); disabled/default-compatible unless enabled.
# Set SPUREL_PDF_OCR_ENABLED=true only after reviewing local OCR requirements.
# OCR runs locally on textless PDF pages during explicit Process/Reprocess only.
# It requires Poppler + Tesseract (bundled in the development backend image).
SPUREL_PDF_OCR_ENABLED=false
SPUREL_PDF_OCR_LANGUAGE=eng
SPUREL_PDF_OCR_MAX_PAGES=5
# plain preserves the existing pypdf output. layout is an explicit opt-in.
SPUREL_PDF_EXTRACTION_MODE=plain

# Grounded answer generation (default unchanged: OpenAI Responses API)
SPUREL_GENERATION_PROVIDER=openai
SPUREL_GENERATION_MODEL=
SPUREL_GENERATION_MAX_OUTPUT_TOKENS=1200

# SP-25: trusted hosted OpenAI-compatible Chat Completions endpoint
# SPUREL_GENERATION_BASE_URL=https://your-chat-service.example/v1
# SPUREL_GENERATION_API_KEY=your-secret-chat-key

# API authentication (required for all API endpoints except /health)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# A missing or weak token disables protected endpoints (HTTP 503).
SPUREL_API_TOKEN=

# Local operator access (SP-10). 'make init' generates these secrets on first run.
# Never put them in NEXT_PUBLIC_* or share them with an untrusted browser client.
# The password is typed into the local sign-in form, and the signing secret stays on the server.
SPUREL_FRONTEND_OPERATOR_PASSWORD=
SPUREL_FRONTEND_SESSION_SECRET=

# Swagger UI / OpenAPI schema are disabled by default. Enable only in trusted local development.
SPUREL_ENABLE_DOCS=0

# Optional SP-21 cross-encoder scoring service (not bundled or started).
# Set only if your trusted HTTP model service is reachable from the backend.
# No calls are made unless a user explicitly enables reranking in Hybrid Retrieval Lab.
# SPUREL_RERANKER_URL=http://reranker:8080/rerank
# SPUREL_RERANKER_MODEL=your-local-cross-encoder
# SPUREL_RERANKER_TOKEN=
