# Spurel local development environment
#
# Copy this file to .env, then export/source the values in your shell
# before starting the backend. Never commit real secrets.

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://spurel:spurel@localhost:5432/spurel

# Local document blob storage (development/testing only)
SPUREL_LOCAL_STORAGE_ROOT=.spurel/storage

# OpenAI
# Keep real API keys only in your local .env or secret manager.
OPENAI_API_KEY=

# Embeddings
SPUREL_EMBEDDING_MODEL=text-embedding-3-small
SPUREL_EMBEDDING_DIMENSIONS=1536

# Grounded answer generation
SPUREL_GENERATION_MODEL=
SPUREL_GENERATION_MAX_OUTPUT_TOKENS=1200

# API authentication (required for all API endpoints except /health)
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# A missing or weak token disables protected endpoints (HTTP 503).
SPUREL_API_TOKEN=

# Swagger UI / OpenAPI schema are disabled by default. Enable only in trusted local development.
SPUREL_ENABLE_DOCS=0
